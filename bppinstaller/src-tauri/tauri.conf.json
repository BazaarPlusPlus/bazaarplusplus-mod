{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BazaarPlusPlus Installer",
  "version": "1.0.4",
  "identifier": "com.bazaarplusplus.bppinstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prebuild-check && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "BazaarPlusPlus Installer",
        "width": 680,
        "height": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyNTNBNDFDNjZENEU5Q0QKUldUTjZkUm1IS1JUUWpXUXR2bWpNUDByWXRVaTZuSSs3VmxnQ3M0UnpQeUhuOW9HVmxKNnhkOXEK",
      "endpoints": [
        "https://native-updater.bazaarplusplus.com/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
