<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../../src/BazaarPlusPlus/Infrastructure/Logging/Core/*.cs"
      Link="Logging/Core/%(Filename)%(Extension)"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/HistoryPanel/HistoryPanelLogEvents.cs"
      Link="HistoryPanelLogEvents.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/HistoryPanel/HistoryPanelLogOperations.cs"
      Link="HistoryPanelLogOperations.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/HistoryPanel/HistoryPanelLogWriter.cs"
      Link="HistoryPanelLogWriter.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/HistoryPanel/HistoryPanelPayloadFailureLogGate.cs"
      Link="HistoryPanelPayloadFailureLogGate.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/HistoryPanel/HistoryPanelReplayCleanup.cs"
      Link="HistoryPanelReplayCleanup.cs"
    />
  </ItemGroup>
</Project>
