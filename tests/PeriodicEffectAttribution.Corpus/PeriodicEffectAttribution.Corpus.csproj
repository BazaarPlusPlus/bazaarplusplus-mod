<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj" />
    <PackageReference Include="MessagePack" />
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../../src/BazaarPlusPlus/Game/PostCombatImpact/Data/CombatImpactModels.cs"
      Link="CombatImpactModels.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/PostCombatImpact/Data/PeriodicEffectAttribution.cs"
      Link="PeriodicEffectAttribution.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/CombatReplay/CombatReplayPayloadStore.cs"
      Link="CombatReplayPayloadStore.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/PvpBattles/PvpReplayPayload.cs"
      Link="PvpReplayPayload.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/PvpBattles/PvpReplayPayloadCodec.cs"
      Link="PvpReplayPayloadCodec.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Infrastructure/AtomicFileWriter.cs"
      Link="AtomicFileWriter.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Infrastructure/FileBackedPayloadStore.cs"
      Link="FileBackedPayloadStore.cs"
    />
  </ItemGroup>
</Project>
