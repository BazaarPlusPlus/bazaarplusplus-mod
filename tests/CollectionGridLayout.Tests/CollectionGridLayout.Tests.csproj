<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectRoot>$(MSBuildThisFileDirectory)../../</ProjectRoot>
    <MacSteamManagedDefault>$(HOME)/Library/Application Support/Steam/steamapps/common/The Bazaar/TheBazaar.app/Contents/Resources/Data/Managed</MacSteamManagedDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ManagedPath)' == '' and Exists('$(MacSteamManagedDefault)/Assembly-CSharp.dll')">
    <ManagedPath>$(MacSteamManagedDefault)</ManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Data\CollectionCardVm.cs"
      Link="CollectionCardVm.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Data\CollectionMerchantKind.cs"
      Link="CollectionMerchantKind.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Grid\CollectionGridConstants.cs"
      Link="CollectionGridConstants.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Grid\CollectionGridCell.cs"
      Link="CollectionGridCell.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Grid\CollectionGridLayout.cs"
      Link="CollectionGridLayout.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Grid\CollectionGridPixelization.cs"
      Link="CollectionGridPixelization.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Grid\CollectionCardMaterialLru.cs"
      Link="CollectionCardMaterialLru.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Infrastructure\UiTokens\BppOverlaySorting.cs"
      Link="BppOverlaySorting.cs"
    />
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
