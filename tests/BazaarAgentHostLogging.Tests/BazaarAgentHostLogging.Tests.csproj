<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BepInEx.Core" />
    <PackageReference Include="BepInEx.BaseLib" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus.BazaarAgent/BazaarPlusPlus.BazaarAgent.csproj" />
    <Compile
      Include="../../src/BazaarPlusPlus.BazaarAgentHost/BazaarAgentBepInExLogger.cs"
      Link="Host/BazaarAgentBepInExLogger.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus.BazaarAgentHost/BazaarAgentLogRenderer.cs"
      Link="Host/BazaarAgentLogRenderer.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus.BazaarAgentHost/BazaarAgentLogStormGuard.cs"
      Link="Host/BazaarAgentLogStormGuard.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus.BazaarAgentHost/BazaarAgentDegradationLogState.cs"
      Link="Host/BazaarAgentDegradationLogState.cs"
    />
    <None Include="$(PkgBepInEx_BaseLib)/lib/netstandard2.0/BepInEx.dll" Link="BepInEx.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
