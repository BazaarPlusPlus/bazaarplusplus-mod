<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectRoot>$(MSBuildThisFileDirectory)../../</ProjectRoot>
    <LocalManagedDefault>$(ProjectRoot)src/BazaarPlusPlus/bin/Debug/netstandard2.1</LocalManagedDefault>
    <MacSteamManagedDefault>$(HOME)/Library/Application Support/Steam/steamapps/common/The Bazaar/TheBazaar.app/Contents/Resources/Data/Managed</MacSteamManagedDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ManagedPath)' == '' and Exists('$(LocalManagedDefault)/BazaarGameShared.dll')">
    <ManagedPath>$(LocalManagedDefault)</ManagedPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ManagedPath)' == '' and Exists('$(MacSteamManagedDefault)/BazaarGameShared.dll')">
    <ManagedPath>$(MacSteamManagedDefault)</ManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\DealerModel\CollectionDealerProbabilityState.cs"
      Link="CollectionDealerProbabilityState.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\DealerModel\EstimateBucket.cs"
      Link="EstimateBucket.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\DealerModel\DealerTierWeightReference.cs"
      Link="DealerTierWeightReference.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\DealerModel\CollectionDealerSourceContext.cs"
      Link="CollectionDealerSourceContext.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\DealerModel\CollectionDealerCardExplain.cs"
      Link="CollectionDealerCardExplain.cs"
    />
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
