<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectRoot>$(MSBuildThisFileDirectory)../../</ProjectRoot>
    <MacSteamManagedDefault>$(HOME)/Library/Application Support/Steam/steamapps/common/The Bazaar/TheBazaar.app/Contents/Resources/Data/Managed</MacSteamManagedDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ManagedPath)' == '' and Exists('$(MacSteamManagedDefault)/Assembly-CSharp.dll')">
    <ManagedPath>$(MacSteamManagedDefault)</ManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Sources\CollectionSourceCatalog.cs"
      Link="CollectionSourceCatalog.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Sources\CollectionSourceDtos.cs"
      Link="CollectionSourceDtos.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Sources\CollectionSourceEntry.cs"
      Link="CollectionSourceEntry.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Sources\CollectionSourceEnums.cs"
      Link="CollectionSourceEnums.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Sources\CollectionSourceOfferPoolResolver.cs"
      Link="CollectionSourceOfferPoolResolver.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Sources\CollectionSourceOfferPoolResult.cs"
      Link="CollectionSourceOfferPoolResult.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Sources\CollectionSourceOfferRule.cs"
      Link="CollectionSourceOfferRule.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Sources\CollectionSourceRoster.cs"
      Link="CollectionSourceRoster.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Data\CollectionCardVm.cs"
      Link="CollectionCardVm.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Data\CollectionCardClassification.cs"
      Link="CollectionCardClassification.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Data\CollectionCardFacetRanks.cs"
      Link="CollectionCardFacetRanks.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\Data\CollectionPanelSelectionState.cs"
      Link="CollectionPanelSelectionState.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\CollectionPanelOpenSelectionResolver.cs"
      Link="CollectionPanelOpenSelectionResolver.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\CollectionPanel\CollectionSourceOfferPoolCacheKey.cs"
      Link="CollectionSourceOfferPoolCacheKey.cs"
    />
    <Reference Include="BazaarBattleService">
      <HintPath>$(ManagedPath)/BazaarBattleService.dll</HintPath>
    </Reference>
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
