<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectRoot>$(MSBuildThisFileDirectory)../../</ProjectRoot>
    <MacSteamManagedDefault>$(HOME)/Library/Application Support/Steam/steamapps/common/The Bazaar/TheBazaar.app/Contents/Resources/Data/Managed</MacSteamManagedDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ManagedPath)' == '' and Exists('$(MacSteamManagedDefault)/BazaarGameShared.dll')">
    <ManagedPath>$(MacSteamManagedDefault)</ManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/CardPreview/NativeCardPreviewSpec.cs"
      Link="NativeCardPreviewSpec.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/BppItemBoard.cs"
      Link="BppItemBoard.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/BppItemBoardCard.cs"
      Link="BppItemBoardCard.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/BppItemBoardId.cs"
      Link="BppItemBoardId.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/BppItemBoardPreviewMapper.cs"
      Link="BppItemBoardPreviewMapper.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/BppItemBoardSlotPlanner.cs"
      Link="BppItemBoardSlotPlanner.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/BppItemBoardSpan.cs"
      Link="BppItemBoardSpan.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/Cards/CardSizeSpan.cs"
      Link="CardSizeSpan.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/BppItemBoardType.cs"
      Link="BppItemBoardType.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/ItemBoardPreviewLayoutMode.cs"
      Link="ItemBoardPreviewLayoutMode.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/ItemBoardPreviewOptions.cs"
      Link="ItemBoardPreviewOptions.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/ItemBoardPreviewOptionsForwarder.cs"
      Link="ItemBoardPreviewOptionsForwarder.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/ItemBoardPreviewSignatureGate.cs"
      Link="ItemBoardPreviewSignatureGate.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/ItemBoardPreviewGenerationGuard.cs"
      Link="ItemBoardPreviewGenerationGuard.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/ItemBoardSocketResolver.cs"
      Link="ItemBoardSocketResolver.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/ItemBoardSlotGridGeometry.cs"
      Link="ItemBoardSlotGridGeometry.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Infrastructure/UiTokens/BppOverlaySorting.cs"
      Link="BppOverlaySorting.cs"
    />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
