<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
    </RestoreAdditionalProjectSources>
  </PropertyGroup>

  <PropertyGroup>
    <MacSteamManagedDefault>$(HOME)/Library/Application Support/Steam/steamapps/common/The Bazaar/TheBazaar.app/Contents/Resources/Data/Managed</MacSteamManagedDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ManagedPath)' == '' and Exists('$(MacSteamManagedDefault)/BazaarGameShared.dll')">
    <ManagedPath>$(MacSteamManagedDefault)</ManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="../../Game/LiveBuildPanel/Data/LiveBuildCandidateState.cs"
      Link="LiveBuildCandidateState.cs"
    />
    <Compile
      Include="../../Game/LiveBuildPanel/Data/LiveItemBoardRowVm.cs"
      Link="LiveItemBoardRowVm.cs"
    />
    <Compile Include="../../GameInterop/ItemBoardPreview/BppItemBoard.cs" Link="BppItemBoard.cs" />
    <Compile
      Include="../../GameInterop/ItemBoardPreview/BppItemBoardCard.cs"
      Link="BppItemBoardCard.cs"
    />
    <Compile
      Include="../../GameInterop/ItemBoardPreview/BppItemBoardId.cs"
      Link="BppItemBoardId.cs"
    />
    <Compile
      Include="../../GameInterop/ItemBoardPreview/BppItemBoardSpan.cs"
      Link="BppItemBoardSpan.cs"
    />
    <Compile
      Include="../../GameInterop/ItemBoardPreview/BppItemBoardType.cs"
      Link="BppItemBoardType.cs"
    />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
