<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>BazaarPlusPlus.ModApi</AssemblyName>
    <RootNamespace>BazaarPlusPlus.ModApi</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <Version>$(BppVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NETStandard.Library" Version="2.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- MessagePack: compile-only reference. Do not bundle a replacement; the plugin runtime
         deliberately loads the game's MessagePack.dll. -->
    <PackageReference
      Include="MessagePack"
      Version="3.1.7"
      ExcludeAssets="runtime"
    />
  </ItemGroup>
</Project>
